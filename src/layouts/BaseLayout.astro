---
import "@fontsource-variable/inter"
import "@fontsource-variable/newsreader/standard.css"
import "../styles/tokens.css"
import "../styles/global.css"
import BaseHead from "../components/BaseHead.astro"
import JsonLd from "../components/JsonLd.astro"
import SiteFooter from "../components/SiteFooter.astro"
import SiteHeader from "../components/SiteHeader.astro"
import SkipLink from "../components/SkipLink.astro"
import { site } from "../config/site"
import type { JsonLdNode } from "../lib/structured-data"

interface Props {
  title: string
  description: string
  noindex?: boolean
  /** schema.org nodes for this page, emitted as one JSON-LD @graph. */
  jsonLd?: readonly JsonLdNode[]
}

const { title, description, noindex = false, jsonLd = [] } = Astro.props
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <BaseHead title={title} description={description} noindex={noindex} />
    {jsonLd.length > 0 && <JsonLd nodes={jsonLd} />}
  </head>
  <body>
    <SkipLink />
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
