---
/** The opening block of an inner page: optional breadcrumb trail, eyebrow, h1 and lede. */
export interface BreadcrumbLink {
  label: string
  href: string
}

interface Props {
  eyebrow: string
  title: string
  lede?: string
  /** Ancestors of this page (Home is added automatically); the current page is `title`. */
  breadcrumbs?: readonly BreadcrumbLink[]
}

const { eyebrow, title, lede, breadcrumbs } = Astro.props
---

<div class="page-header">
  <div class="container">
    {breadcrumbs && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol class="list-reset">
          <li>
            <a href="/">Home</a>
          </li>
          {breadcrumbs.map(crumb => (
            <li>
              <a href={crumb.href}>{crumb.label}</a>
            </li>
          ))}
          <li>
            <span aria-current="page">{title}</span>
          </li>
        </ol>
      </nav>
    )}
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</div>

<style>
  .page-header {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem);
    border-bottom: var(--hairline) solid var(--color-rule);
  }

  .page-header h1 {
    max-width: 18ch;
    margin-block: var(--space-s) var(--space-m);
  }

  .breadcrumbs {
    margin-bottom: var(--space-l);
    font-size: var(--step-minus-1);
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-2xs);
  }

  .breadcrumbs li {
    display: flex;
    gap: var(--space-2xs);
  }

  .breadcrumbs li + li::before {
    content: "/";
    color: var(--color-text-muted);
  }

  .breadcrumbs [aria-current] {
    color: var(--color-text-muted);
  }
</style>
