---
/**
 * The Carpe Tempus mark: the oak from the supplied logo, cut out on transparency
 * (src/assets/brand/oak.png, generated by scripts/render-brand-assets.mjs).
 * Decorative: always pair it with visible text such as the wordmark.
 */
import { Image } from "astro:assets"
import oak from "../assets/brand/oak.png"

interface Props {
  class?: string
  /** Displayed width in CSS pixels; images are generated for 1x, 2x and 3x screens. */
  size: number
}

const { class: className, size } = Astro.props
---

<Image
  src={oak}
  alt=""
  width={size}
  height={size}
  densities={[1, 2, 3]}
  class:list={["mark", className]}
/>
