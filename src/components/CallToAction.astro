---
import Arrow from "./Arrow.astro"
import Mark from "./Mark.astro"

interface Props {
  title?: string
  text?: string
}

const {
  title = "Got a product to ship or a campaign to grow?",
  text = "Tell us where things stand. We’ll reply to arrange a short call and suggest a sensible first step.",
} = Astro.props
---

<section class="cta section section--alt" aria-labelledby="cta-title">
  <div class="container cta-inner">
    <Mark class="cta-mark" size={56} />
    <h2 id="cta-title">{title}</h2>
    <p class="lede">{text}</p>
    <div class="actions">
      <a class="button" href="/contact/">
        Talk to us <Arrow />
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    border-top: var(--hairline) solid var(--color-rule);
  }

  .cta-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    text-align: center;
  }

  .cta-mark {
    width: 3.5rem;
    height: 3.5rem;
  }

  .cta-inner h2 {
    max-width: 20ch;
  }

  .cta-inner .lede {
    color: var(--color-text-muted);
  }

  .cta-inner .actions {
    margin-top: var(--space-2xs);
  }
</style>
