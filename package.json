{
  "name": "carpe-tempus",
  "private": true,
  "version": "1.0.0",
  "description": "Website for Carpe Tempus Ltd, a London consultancy for product engineering and paid social marketing.",
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": "^22.22.1 || >=24.0.0"
  },
  "author": "Carpe Tempus Ltd",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dao-wolf/carpe-tempus-site.git"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "pnpm lint:css && pnpm lint:format",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "verify": "pnpm check && pnpm lint && pnpm build && pnpm test",
    "brand:render": "node scripts/render-brand-assets.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.3.5",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.5",
    "cheerio": "^1.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright-core": "1.56.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,ts,mts,json,md,yml,yaml}": "prettier --write",
    ".prettierrc": "prettier --write",
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.astro": [
      "stylelint --fix",
      "prettier --write"
    ]
  }
}
